<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The demo showcase file, copied to the test output so the import smoke
         test can load it from disk and prove it stays warning-clean. -->
    <Content Include="..\..\samples\sample.json" Link="sample.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="TestUtils.fs" />
    <Compile Include="TestData.fs" />
    <Compile Include="EcsTestSupport.fs" />
    <Compile Include="ModelTests.fs" />
    <Compile Include="ViewModel/LayoutBoxTests.fs" />
    <Compile Include="ViewModel/SceneTests.fs" />
    <Compile Include="ViewModel/VectorTests.fs" />
    <Compile Include="ViewModel/PaletteTests.fs" />
    <Compile Include="ViewModel/ImportMessagesTests.fs" />
    <Compile Include="ViewModel/LocalizationTests.fs" />
    <Compile Include="ViewModel/NodeContentTests.fs" />
    <Compile Include="Traits/EventsTests.fs" />
    <Compile Include="Entities/LineTests.fs" />
    <Compile Include="Entities/BoundingBoxTests.fs" />
    <Compile Include="Entities/PeopleTests.fs" />
    <Compile Include="Entities/ConnectorsTests.fs" />
    <Compile Include="Systems/AnimationTests.fs" />
    <Compile Include="Systems/ControlsTests.fs" />
    <Compile Include="Systems/ViewModeTests.fs" />
    <Compile Include="Systems/SelectionTests.fs" />
    <Compile Include="Systems/FileCommandsTests.fs" />
    <Compile Include="Systems/DraggingTests.fs" />
    <Compile Include="Systems/UndoRedoTests.fs" />
    <Compile Include="Systems/MovementTests.fs" />
    <Compile Include="Systems/LayoutTests.fs" />
    <Compile Include="Systems/RunnerTests.fs" />
    <Compile Include="Systems/LifeCycleTests.fs" />
    <Compile Include="Persistence/JsonReadWriteTests.fs" />
    <Compile Include="Persistence/TransformTests.fs" />
    <Compile Include="Persistence/ImportServiceTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Wilnaatahl.Core/Wilnaatahl.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FsCheck.Xunit.v3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Unquote" />
  </ItemGroup>

</Project>
