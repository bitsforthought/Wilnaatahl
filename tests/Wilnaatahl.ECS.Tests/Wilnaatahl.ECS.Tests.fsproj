<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FableTestInfra.fs" />
    <Compile Include="ECS/TestInfra.fs" />
    <Compile Include="ECS/TraitTests.fs" />
    <Compile Include="ECS/EntityTests.fs" />
    <Compile Include="ECS/QueryTests.fs" />
    <Compile Include="ECS/RelationTests.fs" />
    <Compile Include="ECS/WorldTests.fs" />
    <Compile Include="ECS/TrackingTests.fs" />
    <Compile Include="Runner.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Wilnaatahl.Core/Wilnaatahl.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(FABLE_COMPILER)'!='true'">
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Unquote" Version="6.1.0" />
  </ItemGroup>

</Project>
