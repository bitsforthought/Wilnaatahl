<?xml version="1.0" encoding="utf-8"?>
<!--
  Pin package-source selection to a single, explicit source, independent of
  whatever package sources a developer's or CI machine's global NuGet config
  contributes. Central Package Management (Directory.Packages.props) warns NU1507
  when more than one source is configured without source mapping, and under this
  repo's TreatWarningsAsErrors that warning is fatal, so an inherited extra source
  would fail restore with no code change. Each <clear/> drops the inherited
  machine/user entries for its section:
    - packageSources         so only nuget.org is offered;
    - disabledPackageSources so a machine can't disable nuget.org out from under us;
    - packageSourceMapping   so a machine's mapping can't route our packages
                             elsewhere — the "*" pattern maps every package to
                             nuget.org, so no configured source other than
                             nuget.org can supply a package.
  This governs which source a package resolves from; a machine-local
  fallbackPackageFolder or the global-packages cache is a separate mechanism and
  is intentionally not cleared here. Every package this repo consumes — and every
  dotnet tool in .config/dotnet-tools.json — is published on nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
